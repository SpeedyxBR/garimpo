{
  "name": "garimpo",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de prospecção open source: acha negócios no Google Maps, gera prévia, conversa no WhatsApp e cobra no checkout.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db": "node scripts/db.mjs",
    "dev": "node scripts/db.mjs --se-preciso && next dev",
    "build": "node scripts/db.mjs && next build",
    "start": "next start",
    "tudo": "node scripts/tudo.mjs",
    "senha": "node scripts/senha.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/db.mjs --gerar || true"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.79.0",
    "next": "^16.4.6",
    "open-bot-avatar": "^0.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "simple-icons": "^16.38.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
